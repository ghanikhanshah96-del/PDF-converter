# Resend (contact form + optional admin invites)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# CONTACT_TO_EMAIL=support@bestfreepdfconverter.com

# Admin CMS (use a NEW Firebase project — do not reuse StellixSoft credentials)
ADMIN_USERNAME=http://localhost:3000/admin/login
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string-at-least-32-chars

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional public URL for invite emails / absolute links
# NEXT_PUBLIC_SITE_URL=https://bestfreepdfconverter.com

# Optional SMTP (if you prefer SMTP over Resend for invites)
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# EMAIL_TO=
