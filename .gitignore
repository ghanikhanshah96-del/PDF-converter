# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# Large document engine prepared by scripts/fetch-engine.mjs during dev and build.
/public/engine/

# TinyMCE is copied from node_modules by scripts/copy-tinymce.mjs
/public/tinymce/

# Admin blog uploads (keep folder via .gitkeep)
/public/uploads/blog/*
!/public/uploads/blog/.gitkeep

# env (never commit secrets)
.env
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo
next-env.d.ts
